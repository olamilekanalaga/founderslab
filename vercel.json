{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "refactor/feature-architecture": false,
      "feature/v4-public-homepage": false,
      "redesign/public-experience": false,
      "redesign/admin-experience": false,
      "redesign/admin-studio": false,
      "feature/bd-reward-rules": false,
      "feature/bd-partner-workflow": false,
      "feature/founder-project-identity": false,
      "feature/telegram-booking-notifications": false
    }
  }
}
