# PostgreSQL is required for public booking and private administration.
# Use a dedicated local database; never point test fixtures at production data.
DATABASE_URL="postgresql://founders:REPLACE_WITH_LOCAL_PASSWORD@localhost:55432/founders_lab"
APP_ORIGIN="http://localhost:3000"

# Local Docker Compose database. Set a strong, distinct value.
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"

# Optional legacy bootstrap account, provisioned with npm run db:admin.
# Keep its email configured only if that legacy account still needs access.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME="⭕️La_Crrypt💰₿"
BOOTSTRAP_ADMIN_PASSWORD=""

# Optional integration-test server: localhost only; needs CREATE DATABASE privileges.
# The runner creates and drops its own randomly named database, never this database.
# TEST_DATABASE_URL="postgresql://founders:REPLACE_WITH_LOCAL_PASSWORD@localhost:55432/postgres"

# The Neon integration normally supplies these in Vercel Production.
# Migrations use the direct connection; application requests use the pooled one.
# DATABASE_URL_UNPOOLED="postgresql://..."
# The app also supports DATABASE_DATABASE_URL / STORAGE_DATABASE_URL prefixes.

# Optional email for legacy Space Manager access (Resend).
# APP_ORIGIN must be your canonical HTTPS production URL.
RESEND_API_KEY=""
MANAGER_EMAIL_FROM=""

# Optional private Telegram booking notifications (server only).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
